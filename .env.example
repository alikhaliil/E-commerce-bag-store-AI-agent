# Copy this file to .env and fill in real values. Never commit .env.

# Groq LLM API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LangSmith tracing (optional). Set to true ONLY after adding a real key,
# otherwise every agent call logs a LangSmith authentication error.
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false

# Embedding model for the policy knowledge base (runs locally, no API key).
# After changing it, re-run: python -m app.rag.ingest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Groq chat model. llama-3.3-70b-versatile was shut down on 2026-08-16;
# openai/gpt-oss-120b is Groq's recommended replacement.
GROQ_MODEL=openai/gpt-oss-120b

# Input guardrail classifier (Stage 2). llama-3.1-8b-instant was shut down on
# 2026-08-16; openai/gpt-oss-20b is Groq's recommended replacement.
GUARDRAIL_MODEL=openai/gpt-oss-20b

# LLM-as-a-judge for `python -m evals.run_evals`
EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# --- API server (Phase 6) ---
# Comma-separated allowed origins for CORS (* = any; set your frontend URL in production)
CORS_ORIGINS=*
# Max /api/chat requests per client IP per minute (0 disables)
RATE_LIMIT_PER_MINUTE=20
